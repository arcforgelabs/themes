  "cssVars": {
    "light": {
      "bg-accent": "#f6f3ef",
      "card": "#ffffff",
      "text": "#1d3444",
      "text-strong": "#13242f",
      "muted": "#4d6575",
      "border": "#e0dbd1",
      "border-strong": "#b8a685",
      "ring": "#b08850",
      "accent": "#1d3444",
      "accent-subtle": "#faefdd",
      "on-accent": "#f8dfb9",
      "accent-2": "#526a7a",
      "accent-2-subtle": "rgba(82, 106, 122, 0.1)",
      "series-1": "#1d3444",
      "series-2": "#22663f",
      "series-3": "#8a5a00",
      "series-4": "#ae9064",
      "series-5": "#526a7a",
