      "accent-2": "#a3b2bb",
      "accent-2-subtle": "rgba(163, 178, 187, 0.1)",
      "series-1": "#f8dfb9",
      "series-2": "#86d3a1",
      "series-3": "#e7b75c",
      "series-4": "rgba(248, 223, 185, 0.45)",
      "series-5": "#a3b2bb",
      "shadow-md": "0 1px 2px rgba(0, 0, 0, 0.30)",
      "shadow-lg": "0 1px 2px rgba(0, 0, 0, 0.30)"
    }
