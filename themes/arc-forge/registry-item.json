{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "arc-forge",
  "type": "registry:theme",
  "title": "Arc Forge",
  "description": "Arc Forge. Red, steel and grey. Geist for text, JetBrains Mono for code. The fallback theme. Install: Copy themes/arc-forge/tokens.css and themes/colour-key.css into the page.",
  "cssVars": {
    "light": {
      "bg-accent": "#f2f2f5",
      "card": "#ffffff",
      "text": "#3a3a42",
      "text-strong": "#18181b",
      "muted": "#68676f",
      "border": "#e2e2e8",
      "border-strong": "#ccccd4",
      "ring": "#c41e30",
      "accent": "#c41e30",
      "accent-subtle": "rgba(196,30,48,.08)",
      "on-accent": "#ffffff",
      "accent-2": "#5a626e",
      "accent-2-subtle": "rgba(90,98,110,.08)",
      "series-1": "#c41e30",
      "series-2": "#5a626e",
      "series-3": "#18181b",
      "series-4": "#8a6d3b",
      "series-5": "#3f6f8f",
      "shadow-md": "0 4px 12px rgba(0,0,0,.06)",
      "shadow-lg": "0 12px 28px rgba(0,0,0,.08)"
    },
    "dark": {
      "bg-accent": "#0d0d0f",
      "card": "#111113",
      "text": "#c6c6cb",
      "text-strong": "#f5f5f7",
      "muted": "#8a8a94",
      "border": "#202026",
      "border-strong": "#303038",
      "ring": "#e5243b",
      "accent": "#e7364b",
      "accent-subtle": "rgba(229,36,59,.12)",
      "on-accent": "#0d0d0f",
      "accent-2": "#b8bdc4",
      "accent-2-subtle": "rgba(184,189,196,.1)",
      "series-1": "#ef4e61",
      "series-2": "#b8bdc4",
      "series-3": "#f5f5f7",
      "series-4": "#d9b26a",
      "series-5": "#7fb3d5",
      "shadow-md": "0 4px 16px rgba(0,0,0,.5)",
      "shadow-lg": "0 12px 32px rgba(0,0,0,.6)"
    }
  }
}
