#!/usr/bin/env python3
"""Check every theme against docs/theme-contract.md. Exit 1 on any failure."""
import importlib.machinery
import json
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
add_theme = importlib.machinery.SourceFileLoader("add_theme", str(ROOT / "scripts" / "add-theme")).load_module()

REQUIRED_FILES = ("theme.json", "DESIGN.md", "tokens.css", "registry-item.json")
REQUIRED_KEYS = ("name", "slug", "preset", "values", "install", "pickable")
TEXT_PAIRS = [
    ("foreground", "background"), ("card-foreground", "card"), ("popover-foreground", "popover"),
    ("primary-foreground", "primary"), ("secondary-foreground", "secondary"),
    ("muted-foreground", "background"), ("muted-foreground", "muted"), ("accent-foreground", "accent"),
    ("sidebar-foreground", "sidebar"), ("sidebar-primary-foreground", "sidebar-primary"),
    ("sidebar-accent-foreground", "sidebar-accent"),
]


def luminance(hex_color: str) -> float:
    rgb = [int(hex_color[i:i + 2], 16) / 255 for i in (1, 3, 5)]
    lin = [c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4 for c in rgb]
    return 0.2126 * lin[0] + 0.7152 * lin[1] + 0.0722 * lin[2]


def contrast(a: str, b: str) -> float:
    la, lb = sorted((luminance(a), luminance(b)), reverse=True)
    return (la + 0.05) / (lb + 0.05)


def over(value: str, under: str) -> str:
    """A token painted over an opaque #rrggbb, as the browser shows it: a
    translucent token (oklch(... / 15%)) is blended, not read as solid."""
    hex_color = add_theme.oklch_to_hex(value)
    alpha = int(hex_color[7:9], 16) / 255 if len(hex_color) == 9 else 1.0
    top = [int(hex_color[i:i + 2], 16) for i in (1, 3, 5)]
    base = [int(under[i:i + 2], 16) for i in (1, 3, 5)]
    return "#" + "".join(f"{round(t * alpha + b * (1 - alpha)):02X}" for t, b in zip(top, base))


failures = []
themes = sorted(p for p in (ROOT / "themes").iterdir() if p.is_dir())
for theme_dir in themes:
    slug = theme_dir.name
    missing = [f for f in REQUIRED_FILES if not (theme_dir / f).exists()]
    if missing:
        failures.append(f"{slug}: missing {', '.join(missing)}")
        continue
    theme = json.loads((theme_dir / "theme.json").read_text(encoding="utf-8"))
    for key in REQUIRED_KEYS:
        if key not in theme:
            failures.append(f"{slug}: theme.json has no '{key}'")
    lint = subprocess.run(["npx", "-y", "@google/design.md@0.4.0", "lint", str(theme_dir / "DESIGN.md")],
                          capture_output=True, text=True)
    try:
        errors = json.loads(lint.stdout)["summary"]["errors"]
    except (ValueError, KeyError):
        errors = f"lint did not run: {lint.stderr.strip()[:200]}"
    if errors:
        failures.append(f"{slug}: DESIGN.md lint errors: {errors}")
    css_vars = json.loads((theme_dir / "registry-item.json").read_text(encoding="utf-8"))["cssVars"]
    for mode in ("light", "dark"):
        if mode not in css_vars:
            failures.append(f"{slug}: registry-item.json has no cssVars.{mode}")
    # Preset themes keep the shadcn text pairs. The other themes are checked
    # against the explainer token contract in scripts/design-check.mjs.
    if isinstance(theme.get("preset"), str) and theme["preset"]:
        for mode in ("light", "dark"):
            tokens = css_vars.get(mode, {})
            for fg, bg in TEXT_PAIRS:
                if fg not in tokens or bg not in tokens:
                    failures.append(f"{slug} {mode}: missing token {fg if fg not in tokens else bg}")
                    continue
                surface = over(tokens[bg], "#FFFFFF" if mode == "light" else "#000000")
                ratio = contrast(over(tokens[fg], surface), surface)
                if ratio < 4.5:
                    message = f"{slug} {mode}: {fg} on {bg} is {ratio:.2f}:1, needs 4.5:1"
                    if f"{mode}:{fg}/{bg}" in theme.get("contrastExceptions", {}):
                        print("WARN", message, "(known upstream value; DESIGN.md steers around it)")
                    else:
                        failures.append(message)
    print(f"checked {slug}")

design = subprocess.run(["node", str(ROOT / "scripts" / "design-check.mjs")])
if design.returncode:
    failures.append("design-system check failed")

for f in failures:
    print("FAIL", f)
sys.exit(1 if failures else 0)
