#!/usr/bin/env python3
"""Add or refresh a theme from a shadcn/create preset code.

Usage:
  scripts/add-theme <preset-code> <slug> "<Display name>" [--base radix|base|aria]

Writes themes/<slug>/theme.json, tokens.css and registry-item.json, writes the
front matter of themes/<slug>/DESIGN.md (the prose below it is kept), and
refreshes registry.json. Run it again with the same arguments to pick up
upstream changes to the preset.
"""
from __future__ import annotations

import argparse
import json
import math
import re
import subprocess
import urllib.parse
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
SHADCN = "https://ui.shadcn.com"
RADIUS_STEPS = [("sm", 0.6), ("md", 0.8), ("lg", 1.0), ("xl", 1.4), ("2xl", 1.8), ("3xl", 2.2), ("4xl", 2.6)]


def fetch_json(url: str) -> dict:
    with urllib.request.urlopen(url, timeout=30) as resp:
        return json.load(resp)


def decode(code: str) -> dict:
    out = subprocess.check_output(["npx", "-y", "shadcn@latest", "preset", "decode", code, "--json"])
    return json.loads(out)["values"]


def resolve(values: dict, base: str) -> dict:
    params = {"base": base, "rtl": "false", **values}
    if params.get("fontHeading") == "inherit":
        params.pop("fontHeading")
    return fetch_json(f"{SHADCN}/init?" + urllib.parse.urlencode(params))


def font(item_name: str, style: str) -> dict | None:
    try:
        item = fetch_json(f"{SHADCN}/r/styles/{style}/{item_name}.json")
    except Exception:
        return None
    f = item.get("font", {})
    family = f.get("import", "").replace("_", " ")
    generic = f.get("family", "sans-serif").split(",")[-1].strip()
    return {"family": family, "generic": generic, "variable": f.get("variable"), "package": f.get("dependency")}


def oklch_to_hex(value: str) -> str:
    m = re.match(r"oklch\(\s*([\d.]+)\s+([\d.]+)\s+([\d.]+)(?:\s*/\s*([\d.]+)(%?))?\s*\)", value)
    if not m:
        return value
    L, C, H = (float(m.group(i)) for i in (1, 2, 3))
    a, b = C * math.cos(math.radians(H)), C * math.sin(math.radians(H))
    l_ = (L + 0.3963377774 * a + 0.2158037573 * b) ** 3
    m_ = (L - 0.1055613458 * a - 0.0638541728 * b) ** 3
    s_ = (L - 0.0894841775 * a - 1.2914855480 * b) ** 3
    rgb = (
        4.0767416621 * l_ - 3.3077115913 * m_ + 0.2309699292 * s_,
        -1.2684380046 * l_ + 2.6097574011 * m_ - 0.3413193965 * s_,
        -0.0041960863 * l_ - 0.7034186147 * m_ + 1.7076147010 * s_,
    )

    def channel(x: float) -> int:
        x = 12.92 * x if x <= 0.0031308 else 1.055 * x ** (1 / 2.4) - 0.055
        return round(min(max(x, 0.0), 1.0) * 255)

    out = "#" + "".join(f"{channel(x):02x}" for x in rgb)
    if m.group(4):
        alpha = float(m.group(4)) / (100 if m.group(5) else 1)
        out += f"{round(alpha * 255):02x}"
    return out.upper()


def css_block(selector: str, tokens: dict, indent: str = "") -> list[str]:
    lines = [f"{indent}{selector} {{"]
    lines += [f"{indent}  --{k}: {v};" for k, v in tokens.items()]
    if "dark" in selector:
        lines.append(f"{indent}  color-scheme: dark;")
    return lines + [f"{indent}}}"]


def tokens_css(name: str, code: str, light: dict, dark: dict, fonts: dict) -> str:
    radius = light.get("radius", "0.625rem")
    rem = float(radius.replace("rem", ""))
    base = {k: v for k, v in light.items() if k != "radius"}
    shape = {"radius": radius}
    shape.update({f"radius-{n}": f"{round(rem * 16 * mult, 1):g}px" for n, mult in RADIUS_STEPS})
    sans, heading = fonts["sans"], fonts["heading"]
    type_vars = {
        "font-sans": f"\"{sans['family']}\", ui-sans-serif, system-ui, {sans['generic']}",
        "font-heading": f"\"{heading['family']}\", {heading['generic']}" if heading else "var(--font-sans)",
    }
    families = [sans] + ([heading] if heading else [])
    gf = "&".join("family=" + f["family"].replace(" ", "+") + ":wght@400;500;600;700" for f in families)
    out = [
        f"/* {name}: shadcn preset {code}. Generated by scripts/add-theme. Do not edit by hand. */",
        f"/* Fonts: <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?{gf}&display=swap\"> */",
        "",
    ]
    out += css_block(":root", {**base, **shape, **type_vars})
    out += ["", "@media (prefers-color-scheme: dark) {"]
    out += css_block(':root:not([data-theme="light"])', dark, "  ")
    out += ["}", ""]
    out += css_block(':root[data-theme="dark"]', dark)
    out += ["", "body { background: var(--background); color: var(--foreground); font-family: var(--font-sans); }", ""]
    return "\n".join(out)


def design_front_matter(name: str, code: str, values: dict, light: dict, dark: dict, fonts: dict) -> str:
    lines = ["---", f"name: {name}", f"description: shadcn preset {code} ({values['style']} style, {values['baseColor']} base, {values['theme']} theme)", "colors:"]
    for k, v in light.items():
        if k != "radius":
            lines.append(f"  {k}: \"{oklch_to_hex(v)}\"")
    for k, v in dark.items():
        lines.append(f"  dark-{k}: \"{oklch_to_hex(v)}\"")
    sans = fonts["sans"]["family"]
    heading = fonts["heading"]["family"] if fonts["heading"] else sans
    lines += [
        "typography:",
        f"  heading: {{fontFamily: {heading}, fontSize: 1.5rem, fontWeight: 600, lineHeight: 2rem}}",
        f"  card-title: {{fontFamily: {heading}, fontSize: 1rem, fontWeight: 500, lineHeight: 1.5rem}}",
        f"  body: {{fontFamily: {sans}, fontSize: 0.875rem, fontWeight: 400, lineHeight: 1.25rem}}",
        f"  label: {{fontFamily: {sans}, fontSize: 0.875rem, fontWeight: 500, lineHeight: 1.25rem}}",
        f"  caption: {{fontFamily: {sans}, fontSize: 0.75rem, fontWeight: 500, lineHeight: 1rem}}",
        "rounded:",
    ]
    rem = float(light.get("radius", "0.625rem").replace("rem", ""))
    lines += [f"  {n}: {round(rem * 16 * mult, 1):g}px" for n, mult in RADIUS_STEPS]
    lines += ["spacing:", "  xs: 4px", "  sm: 8px", "  md: 12px", "  lg: 16px", "  xl: 24px", "---"]
    return "\n".join(lines) + "\n"


def write_design_md(path: Path, front: str, name: str, code: str) -> None:
    body = (
        f"\n## Overview\n\nTODO: describe {name} in two or three sentences: its mood and what it suits.\n"
        f"Install: `npx shadcn@latest apply --preset {code}`.\n"
    )
    if path.exists():
        text = path.read_text(encoding="utf-8")
        parts = text.split("---\n", 2)
        if text.startswith("---\n") and len(parts) == 3:
            body = parts[2] if parts[2].startswith("\n") else "\n" + parts[2]
    path.write_text(front + body, encoding="utf-8")


def refresh_registry() -> None:
    items = []
    for item_path in sorted(ROOT.glob("themes/*/registry-item.json")):
        item = json.loads(item_path.read_text(encoding="utf-8"))
        items.append({k: item[k] for k in ("name", "type", "title", "description")} | {
            "files": [], "cssVars": item["cssVars"]})
    registry = {"$schema": "https://ui.shadcn.com/schema/registry.json", "name": "arcforge",
                "homepage": "https://github.com/arcforgelabs/themes", "items": items}
    (ROOT / "registry.json").write_text(json.dumps(registry, indent=2) + "\n", encoding="utf-8")


def main() -> None:
    p = argparse.ArgumentParser()
    p.add_argument("code")
    p.add_argument("slug")
    p.add_argument("name")
    p.add_argument("--base", default="radix", choices=["radix", "base", "aria"])
    args = p.parse_args()

    values = decode(args.code)
    item = resolve(values, args.base)
    light, dark = item["cssVars"]["light"], item["cssVars"]["dark"]
    style = f"{args.base}-{values['style']}"
    fonts = {
        "sans": font(f"font-{values['font']}", style) or {"family": "system-ui", "generic": "sans-serif"},
        "heading": None if values.get("fontHeading", "inherit") == "inherit"
        else font(f"font-heading-{values['fontHeading']}", style),
    }

    out = ROOT / "themes" / args.slug
    out.mkdir(parents=True, exist_ok=True)
    theme = {
        "name": args.name,
        "slug": args.slug,
        "preset": args.code,
        "base": args.base,
        "values": values,
        "fonts": fonts,
        "install": f"npx shadcn@latest apply --preset {args.code}",
        "create": f"{SHADCN}/create?preset={args.code}",
        "generated": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    }
    old = out / "theme.json"
    if old.exists():
        prev = json.loads(old.read_text(encoding="utf-8"))
        for key in ("pickable", "summary", "mirror", "contrastExceptions"):
            if key in prev:
                theme[key] = prev[key]
    theme.setdefault("pickable", True)
    theme.setdefault("summary", "")
    old.write_text(json.dumps(theme, indent=2) + "\n", encoding="utf-8")

    (out / "tokens.css").write_text(tokens_css(args.name, args.code, light, dark, fonts), encoding="utf-8")
    registry_item = {
        "$schema": "https://ui.shadcn.com/schema/registry-item.json",
        "name": args.slug,
        "type": "registry:theme",
        "title": args.name,
        "description": f"{args.name}: shadcn preset {args.code}. For the full style, fonts and icons use `{theme['install']}`.",
        "cssVars": {"light": light, "dark": dark},
    }
    (out / "registry-item.json").write_text(json.dumps(registry_item, indent=2) + "\n", encoding="utf-8")
    write_design_md(out / "DESIGN.md", design_front_matter(args.name, args.code, values, light, dark, fonts), args.name, args.code)
    refresh_registry()
    print(f"themes/{args.slug}: {values['style']} / {values['baseColor']} / {values['theme']}")


if __name__ == "__main__":
    main()
